; SCC Endpoint Credentials (02-credentials.md) and connection proof
; (04-delivery.md §4.1)

; ---- Endpoint credential: a CWT (RFC 8392) ----

endpoint-credential = [cose-protected, cose-unprotected, payload: bstr .cbor endpoint-claims, cose-signature]

endpoint-claims = {
  1 => ebw-url,                                   ; iss
  2 => subject-id,                           ; sub
  4 => time,                                  ; exp
  5 => time,                                  ; nbf
  6 => time,                                  ; iat
  8 => { 1 => COSE_Key },                     ; cnf: the endpoint key
  65535 => credential-status,                 ; status
  "roles" => [+ role],
  ? "holder" => holder-id,
}

credential-status = {
  "status_list": {
    "idx": uint,
    "uri": tstr .regexp "https://.+",
  },
}

; ---- Status list token (§5.3; draft-ietf-oauth-status-list) ----

status-list-token = #6.18([cose-protected, cose-unprotected,
                           payload: bstr .cbor status-list-claims,
                           cose-signature])

status-list-claims = {
  1 => ebw-url,                                   ; iss
  2 => tstr,                                  ; sub: the status list URI
  6 => time,                                  ; iat
  4 => time,                                  ; exp
  ? 5 => time,                                ; nbf
  ? 65534 => uint,                            ; ttl, in seconds
  65533 => status-list,                       ; status_list
}

status-list = {
  "bits": 1 / 2,
  "lst": bstr,
}

; ---- Credential request (§5.1), signed by the new endpoint key ----

credential-request = [cose-protected, cose-unprotected, payload: bstr .cbor credential-request-body, cose-signature]

credential-request-body = {
  "type": "credential-request",
  "owner": ebw-url,
  ? "subject": subject-id,
  "roles": [* role],
  "key": COSE_Key,
  "nonce": bstr .size (16..32),
}

; ---- Connection proof (04-delivery.md §4.1), signed by the endpoint key ----

connect-proof = [cose-protected, cose-unprotected, payload: bstr .cbor connect-proof-body, cose-signature]

connect-proof-body = {
  "type": "connect-proof",
  "challenge": bstr,
  "rds": tstr,                 ; URL of this RDS
  "owner": ebw-url,
  "subject": subject-id,
  "signed_at": time,
}
